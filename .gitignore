# Chỉ bỏ qua cache Python (tự sinh lại khi chạy; commit sẽ gây xung đột giữa các phiên).
# Mọi kết quả, log, bản nháp đều đưa lên git để các phiên cloud dùng chung.
__pycache__/
*.pyc
.pytest_cache/
# Log thô của các biến thể độ nhạy (~270 MB) — tái tạo bằng python -m scenarios.batch --bien_the …
ket_qua/do_nhay/rq1_*/
# Log thô tải từ chuỗi thật (hàng chục đến hàng trăm MB) — tải lại bằng scenarios.lay_log_bsc / scenarios.quet_tuong_that.
# Chỉ commit ung_vien.csv.
ket_qua/that/**/su_kien.csv
ket_qua/that/**/swap.csv
ket_qua/that_quet/**/hep.csv
ket_qua/that_quet/*_nhanh/
# Log thô của bộ kiểm RQ1 ngoài mẫu (~70 MB) — tái tạo trong 30 giây: python -m scenarios.batch --kiem --seeds 10
ket_qua/rq1_kiem/
# Bản tính lại RQ1 từ log cũ thiếu meta (lệch, không dùng); số đúng lấy từ ket_qua/gd2/tomtat_v4.csv
ket_qua/rq1/loi_du.csv
ket_qua/rq1/loi_du_theo_luot.csv
